# Every environment variable the front end reads. Copy to `.env.local` for
# development, or set them on the deployment; `.env.local` is gitignored and
# this file is the exception that documents it, so it must never hold a real
# value.
#
# All five are optional in the sense that `next build` and `next dev` succeed
# without any of them. What each one costs when it is missing is the useful
# thing to know, so that is what is written down here.


# --- the site ------------------------------------------------------------

# Where this is deployed, absolute and with the scheme. Open Graph tags need
# absolute urls and the only thing that knows the domain is the deployment.
# Unset, `layout.tsx` falls back to http://localhost:3000, which produces a
# link preview that is wrong only in development, where nobody is sharing
# links. Set it in production or shared links get no image.
NEXT_PUBLIC_SITE_URL=https://example.com

# Umami website id. Unset, no tracker script is loaded at all -- which is what
# keeps development out of the numbers without any domain filtering, and is why
# every call in `lib/analytics` is a no-op rather than an error when it is
# absent. Cookieless and carrying no identifier; see that file.
NEXT_PUBLIC_UMAMI_ID=


# --- reporting -----------------------------------------------------------
# Read by `app/api/report/route.ts`, server-side only. Note the absence of a
# NEXT_PUBLIC_ prefix on all three: anything carrying it is inlined into the
# browser bundle, and an api key that ships to the client is not a secret.
#
# Without the first two the endpoint answers 503 and the panel says reporting
# is not switched on for this build, so the game is unharmed and the button is
# honest about it rather than appearing to work.

# From the Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Where reports are delivered. One address.
REPORT_TO=you@example.com

# Who they come from. Optional, and left unset it sends from Resend's shared
# onboarding sender, which can only deliver to the address the Resend account
# itself was registered with -- fine when that is REPORT_TO, which is the usual
# case here. Set this only once a verified domain exists to send from.
# REPORT_FROM=Quintessence <reports@example.com>
